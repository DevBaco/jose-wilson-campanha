---
import SocialLinks from './SocialLinks.astro';
import { WHATSAPP_HREF } from '../lib/site';

interface Props {
  mode?: 'home' | 'inner';
  secondaryHref?: string;
  secondaryLabel?: string;
}

const { mode = 'inner', secondaryHref, secondaryLabel } = Astro.props;
const isHome = mode === 'home';
/* Na home o único botão é o "Quero apoiar"; nas páginas internas o botão
   secundário continua sendo o caminho de volta (Início / Blog). */
const utilityHref = secondaryHref ?? (isHome ? null : '/');
const utilityLabel = secondaryLabel ?? (isHome ? null : 'Início');
const showUtility = Boolean(utilityHref && utilityLabel);
const utilityExternal = utilityHref?.startsWith('http') ?? false;

/* a ordem acompanha a da home: apresentação, história, bandeira, blog, apoio */
const navItems = [
  { label: 'Apresentação', href: '#apresentacao' },
  { label: 'História', href: '#historia' },
  { label: 'Propostas', href: '#economia' },
  { label: 'Blog', href: '#blog' },
  { label: 'Apoie', href: '#apoie' },
];
---

<header class="site-header">
  <div class="wrap header-inner">
    <a href={isHome ? '#inicio' : '/'} class="brand" aria-label="Início — Wilson Campos">
      <span class="brand-wordmark">
        <b>Wilson Campos</b>
        <small>Candidato a Deputado Estadual</small>
      </span>
      <span class="brand-sep" aria-hidden="true"></span>
      <img class="brand-democrata" src="/assets/logo-democrata.png" alt="Democrata 35" width="256" height="256" />
    </a>

    {
      isHome && (
        <nav class="nav" aria-label="Navegação principal">
          {navItems.map((item) => <a class="nav-link" href={item.href}>{item.label}</a>)}
        </nav>
      )
    }

    <div class="header-cta">
      {
        showUtility && (
          <a
            class="btn btn-outline"
            href={utilityHref}
            target={utilityExternal ? '_blank' : undefined}
            rel={utilityExternal ? 'noreferrer' : undefined}
          >
            {utilityLabel}
          </a>
        )
      }
      <SocialLinks class="header-social" />
      <a class="btn btn-milho" data-whatsapp href={WHATSAPP_HREF} target="_blank" rel="noreferrer">Quero apoiar</a>
    </div>

    {
      isHome && (
        <button class="menu-toggle" type="button" aria-label="Abrir menu" aria-expanded="false">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
            <path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round" />
          </svg>
        </button>
      )
    }
  </div>

  {
    isHome && (
      <div class="mobile-menu" hidden>
        <div class="wrap">
          {navItems.map((item) => <a class="mobile-link" href={item.href}>{item.label}</a>)}
          <SocialLinks class="mobile-social" />
          <a class="btn btn-milho" data-whatsapp style="margin-top:14px" href={WHATSAPP_HREF} target="_blank" rel="noreferrer">
            Quero apoiar
          </a>
        </div>
      </div>
    )
  }
</header>

<script>
  const menuButton = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const mobileMenu = document.querySelector<HTMLElement>('.mobile-menu');

  menuButton?.addEventListener('click', () => {
    const open = menuButton.getAttribute('aria-expanded') === 'true';
    menuButton.setAttribute('aria-expanded', String(!open));
    if (mobileMenu) mobileMenu.hidden = open;
  });

  mobileMenu?.querySelectorAll('a').forEach((link) =>
    link.addEventListener('click', () => {
      menuButton?.setAttribute('aria-expanded', 'false');
      mobileMenu.hidden = true;
    }),
  );
</script>
