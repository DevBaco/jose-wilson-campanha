}
---

<div class={className ? `social-links ${className}` : 'social-links'} role="list" aria-label={label}>
  {
    socials.map((social) => (
      <a
        class="social-link"
        role="listitem"
        href={social.href}
        data-whatsapp={social.name === 'WhatsApp' ? true : undefined}
        target="_blank"
        rel="noreferrer"
        aria-label={`${social.name} — ${social.handle}`}
        title={`${social.name} ${social.handle}`}
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
          <path d={social.path} />
        </svg>
      </a>
    ))
  }
</div>
