---
import SocialLinks from './SocialLinks.astro';
import { EMAIL, PRIVACY_PATH } from '../lib/site';

interface Props {
  primaryHref?: string;
  primaryLabel?: string;
}

const { primaryHref = '/blog', primaryLabel = 'Blog' } = Astro.props;

/* o ano vem do build: não vira 2026 eterno na virada do ano */
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <div class="footer-logos">
        <img src="/assets/logo-democrata.png" alt="Democrata 35" width="256" height="256" />
      </div>
      <div>
        <strong>Wilson Campos</strong>
        <p>Candidato a Deputado Estadual · Democrata 35</p>
      </div>
    </div>
    <div class="footer-links">
      <SocialLinks whatsapp label="Redes sociais e WhatsApp de Wilson Campos" />
      <a href={primaryHref}>{primaryLabel}</a>
      <a class="footer-email" href={`mailto:${EMAIL}`}>{EMAIL}</a>
      <a href={PRIVACY_PATH}>Política de Privacidade</a>
      <span>Itabira · Minas Gerais</span>
    </div>
  </div>

  <div class="wrap footer-legal">
    <p>© {year} Wilson Campos. Todos os direitos reservados.</p>
  </div>
</footer>
