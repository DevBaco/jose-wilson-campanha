---
import Layout from '../layouts/Layout.astro';
import BlogCard from '../components/BlogCard.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PhoneVideo from '../components/PhoneVideo.astro';
import SocialLinks from '../components/SocialLinks.astro';
import SiteHeader from '../components/SiteHeader.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { getCollection } from 'astro:content';
import {
  EMAIL,
  FACEBOOK_HREF,
  FORM_ENDPOINT,
  WHATSAPP_HREF,
  INSTAGRAM_HREF,
  PHONE_DISPLAY,
  PRIVACY_PATH,
  SITE_URL,
  TIKTOK_HREF,
  TURNSTILE_SITE_KEY,
  absoluteUrl,
} from '../lib/site';

const siteUrl = Astro.site ?? new URL(SITE_URL);
const homeUrl = absoluteUrl('/', siteUrl);
const websiteId = `${homeUrl}#website`;
const personId = `${homeUrl}#wilson-campos`;
const candidateImage = absoluteUrl('/assets/wilson-campos-retrato.jpg', siteUrl);

const homeStructuredData = [
  {
    '@type': 'WebSite',
    '@id': websiteId,
    url: homeUrl,
    name: 'Wilson Campos',
    description: 'Site de Wilson Campos, candidato a deputado estadual por Minas Gerais.',
    inLanguage: 'pt-BR',
    publisher: { '@id': personId },
  },
  {
    '@type': 'Person',
    '@id': personId,
    name: 'Wilson Campos',
    alternateName: 'José Wilson Campos',
    url: homeUrl,
    image: candidateImage,
    description:
      'Candidato a deputado estadual por Minas Gerais, defensor do desenvolvimento econômico, da educação e da geração de oportunidades em Itabira.',
    jobTitle: 'Candidato a Deputado Estadual por Minas Gerais',
    sameAs: [FACEBOOK_HREF, INSTAGRAM_HREF, TIKTOK_HREF],
    mainEntityOfPage: { '@id': `${homeUrl}#webpage` },
    homeLocation: {
      '@type': 'Place',
      name: 'Itabira, Minas Gerais, Brasil',
    },
    affiliation: {
      '@type': 'Organization',
      name: 'Democrata',
    },
    contactPoint: {
      '@type': 'ContactPoint',
      telephone: '+55-31-99963-7470',
      email: EMAIL,
      contactType: 'Atendimento da campanha',
      availableLanguage: 'Portuguese',
      areaServed: {
        '@type': 'AdministrativeArea',
        name: 'Minas Gerais',
      },
    },
  },
];

const HOME_BLOG_LIMIT = 3;
const posts = (await getCollection('noticias', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, HOME_BLOG_LIMIT);

/* calculado no build para a conta não envelhecer sozinha */
const ARRIVAL_YEAR = 1981;
const yearsInItabira = new Date().getFullYear() - ARRIVAL_YEAR;

const storyStats = [
  { value: String(ARRIVAL_YEAR), label: 'Ano em que chegou a Itabira' },
  { value: `${yearsInItabira} anos`, label: 'De vida e trabalho na cidade' },
  { value: '35', label: 'Democrata, o número na urna' },
];

const timeline = [
  {
    label: '1981',
    title: 'O começo em Itabira',
    text: 'Chegou à cidade para trabalhar com o tio Francisco, o Chiquinho da Nacional. Foi aqui que sua história começou.',
  },
  {
    label: 'Raízes',
    title: 'Família e trabalho',
    text: 'Itabira o acolheu, abriu oportunidades e se tornou o lugar onde criou sua família e se tornou empresário.',
  },
  {
    label: 'Participação',
    title: 'Servir à comunidade',
    text: 'Foi presidente da CDL Itabira e diretor comercial na ACITA, além de presidir o Lions Clube Itabira Centro.',
  },
  {
    label: 'Legado',
    title: 'União e compromisso',
    text: 'Foi um dos fundadores da Loja Maçônica União e Paz e contribuiu diretamente para a construção da sede da entidade.',
  },
  {
    label: 'Hoje',
    title: 'Uma nova missão',
    text: 'Coloca seu nome à disposição para deputado estadual com o compromisso de defender nossa gente e gerar oportunidades.',
  },
];

// entidades que representam o comércio de Itabira e sustentam a bandeira
// econômica: o que cada uma é e o que a passagem por elas ensinou
const institutions = [
  {
    id: 'acita',
    name: 'ACITA',
    fullName: 'Associação Comercial, Industrial, de Serviços e Agropecuária · desde 1925',
    role: 'Ex-diretor comercial',
    period: '',
    logo: '/assets/loog-acita-branca-laranja.svg',
    logoWidth: 392,
    logoHeight: 132,
    text: 'Reúne comércio, indústria, serviços e agropecuária — os setores que produzem e empregam na cidade.',
    note: 'Sentar à mesa com esses setores é saber o que trava um negócio em Itabira.',
  },
  {
    id: 'cdl',
    name: 'CDL Itabira',
    fullName: 'Câmara de Dirigentes Lojistas de Itabira',
    role: 'Ex-presidente',
    period: '1999 — 2001',
    logo: '/assets/logo-cdl.png',
    logoWidth: 480,
    logoHeight: 174,
    text: 'Representa o varejo, aproximando lojistas, prestadores de serviço e instituições financeiras.',
    note: 'Três anos à frente de quem abre as portas, contrata e movimenta a renda da cidade.',
  },
];

const economyChain = [
  {
    step: '01',
    title: 'Ambiente para empreender',
    text: 'Menos entrave para quem quer abrir, manter e fazer crescer um negócio em Itabira.',
  },
  {
    step: '02',
    title: 'Negócio que cresce contrata',
    text: 'Cada empresa que se fortalece se converte em vaga de trabalho para quem mora na cidade.',
  },
  {
    step: '03',
    title: 'Oportunidade que fica aqui',
    text: 'Mais emprego e mais renda circulando em Itabira é o que abre futuro para as próximas gerações.',
  },
];

---

<Layout
  title="Wilson Campos | Candidato a Deputado Estadual por MG"
  description="Conheça Wilson Campos, candidato a deputado estadual por Minas Gerais: gratidão por Itabira, desenvolvimento econômico, educação e geração de oportunidades."
  mainEntityId={personId}
  structuredData={homeStructuredData}
>
  <SiteHeader mode="home" />

  <main id="inicio">
    <!-- HERO -->
    <section class="hero">
      <h1 class="sr-only">Wilson Campos — Pré-candidato a Deputado Estadual por Minas Gerais</h1>

      <div class="hero-banner reveal">
        <figure class="hero-art">
          <img
            src="/assets/banner-wilson.webp"
            alt="Wilson Campos, pré-candidato a deputado estadual por Minas Gerais"
            width="1774"
            height="887"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <figcaption class="hero-banner-caption">
            <p class="hero-subtitle">
              <strong>Desenvolvimento para Minas Gerais.</strong>
              <span>Gratidão por Itabira.</span>
            </p>
          </figcaption>
        </figure>
      </div>

      <div class="hero-rail" aria-hidden="true">
        <div class="hero-rail-track">
          <span>Força para Minas Gerais</span><i></i><span>Gratidão por Itabira</span><i></i><span>Desenvolvimento econômico</span><i></i>
          <span>Força para Minas Gerais</span><i></i><span>Gratidão por Itabira</span><i></i><span>Desenvolvimento econômico</span>
        </div>
      </div>
    </section>

    <!-- APRESENTAÇÃO EM VÍDEO -->
    <section id="apresentacao" class="section story-section">
      <div class="wrap story-grid">
        <div class="story-collage story-collage-video reveal">
          <PhoneVideo
            src="/assets/wilson-campos-reel.mp4"
            poster="/assets/wilson-campos-reel-poster.jpg"
            label="Wilson Campos se apresenta como pré-candidato a deputado estadual"
            caption="Wilson se apresenta — 34 segundos"
          />
        </div>

        <div class="story-copy reveal">
          <p class="eyebrow">Apresentação</p>
          <h2 class="title">Uma história de trabalho e gratidão.</h2>
          <div class="story-facts" aria-label="Informações da candidatura">
            <span>Candidato a deputado estadual</span>
            <span>Democrata 35</span>
            <span>Itabira · Minas Gerais</span>
          </div>
          <p class="story-intro">
            Wilson chegou a Itabira em 1981 para trabalhar com o tio Chiquinho. Foi aqui que empreendeu, criou a
            família e construiu tudo o que tem.
          </p>
          <p class="story-text">
            Agora quer transformar {yearsInItabira} anos de gratidão em trabalho: levar Itabira para a Assembleia
            Legislativa e defender desenvolvimento, educação e oportunidade para quem vive aqui.
          </p>

          {/* os números dão chão à história: quando chegou, há quanto tempo, e o número na urna */}
          <dl class="story-stats" aria-label="Wilson Campos em números">
            {
              storyStats.map((stat) => (
                <div>
                  <dt>{stat.value}</dt>
                  <dd>{stat.label}</dd>
                </div>
              ))
            }
          </dl>

          <div class="section-actions">
            <a class="btn btn-milho" href="#apoie">Quero apoiar a campanha</a>
          </div>
        </div>
      </div>
    </section>

    <!-- TRAJETÓRIA -->
    <section id="historia" class="section history-section">
      <div class="wrap">
        <div class="history-head reveal">
          <p class="eyebrow">História de vida</p>
          <h2 class="title">De 1981 até hoje, uma história feita junto com Itabira.</h2>
          <p class="story-intro">
            Uma trajetória de trabalho, participação e gratidão que agora se transforma em um novo compromisso com a cidade.
          </p>
        </div>

        <figure class="history-panorama reveal">
          <img
            src="/assets/itabira-panorama.webp"
            srcset="/assets/itabira-panorama-1200.webp 1200w, /assets/itabira-panorama.webp 2400w"
            sizes="(min-width: 1240px) 1200px, 100vw"
            alt="Vista panorâmica da região central de Itabira, Minas Gerais"
            width="2400"
            height="362"
            loading="lazy"
            decoding="async"
          />
          <figcaption>“Servir é a melhor forma de agradecer.”</figcaption>
        </figure>
        <p class="image-credit reveal">
          Foto “Vista panorâmica da região central de Itabira MG”, de{' '}
          <a href="https://commons.wikimedia.org/wiki/User:HVL" target="_blank" rel="noreferrer">HVL</a>, via{' '}
          <a
            href="https://commons.wikimedia.org/wiki/File:Vista_panor%C3%A2mica_da_regi%C3%A3o_central_de_Itabira_MG.JPG"
            target="_blank"
            rel="noreferrer"
          >
            Wikimedia Commons
          </a>, sob licença{' '}
          <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noreferrer">CC BY 4.0</a>. Imagem
          redimensionada e recortada para uso na web.
        </p>

        <div class="timeline reveal">
            {
              timeline.map((item) => (
                <article>
                  <span class="timeline-marker" aria-hidden="true"></span>
                  <span class="timeline-label">{item.label}</span>
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </article>
              ))
            }
        </div>

        <div class="section-actions history-actions reveal">
            <a class="btn btn-milho" href="#apoie">Fale com o Wilson</a>
        </div>
      </div>
    </section>

    <!-- CITAÇÃO -->
    <section class="section band-quote">
      <div class="wrap reveal">
        <blockquote>Chegou o momento de retribuir aquilo que Itabira já me proporcionou.</blockquote>
        <cite>Wilson Campos</cite>
      </div>
    </section>

    <!-- DESENVOLVIMENTO ECONÔMICO -->
    <section id="economia" class="section economy-band">
      <div class="wrap economy-layout">
        <div class="economy-content">
          <div class="economy-head reveal">
            <div class="economy-heading">
              <p class="eyebrow">Principal bandeira</p>
              <h2 class="title">Desenvolvimento econômico de verdade.</h2>
            </div>
            <p class="lead">
              Cidade que gera oportunidade não perde a sua gente. O compromisso é facilitar a vida de quem empreende,
              fortalece negócios e cria empregos para quem vive aqui.
            </p>
          </div>

          <ol class="economy-chain reveal">
            {
              economyChain.map((item) => (
                <li>
                  <span class="economy-step" aria-hidden="true">{item.step}</span>
                  <div>
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                  </div>
                </li>
              ))
            }
          </ol>

          <div class="section-actions economy-actions reveal">
            <a class="btn btn-outline" href="#apoie">Apoie essa transformação</a>
          </div>
        </div>

        <aside class="economy-institutions reveal" aria-label="Entidades do comércio ligadas à trajetória de Wilson Campos">
          <p class="economy-institutions-title">Trajetória nas entidades do comércio</p>

          <div class="economy-orgs">
            {
              institutions.map((org) => (
                <article class={`economy-org economy-org-${org.id}`}>
                  <div class="economy-org-brand">
                    <img
                      src={org.logo}
                      alt={org.name}
                      width={org.logoWidth}
                      height={org.logoHeight}
                      loading="lazy"
                    />
                  </div>
                  <div class="economy-org-body">
                    <p class="economy-org-role">
                      {org.role}
                      {org.period && <span>{org.period}</span>}
                    </p>
                    <h3>{org.name}</h3>
                    <p class="economy-org-name">{org.fullName}</p>
                    <p class="economy-org-text">{org.text}</p>
                    <p class="economy-org-note">
                      <b>Por que importa:</b> {org.note}
                    </p>
                  </div>
                </article>
              ))
            }
          </div>
        </aside>
      </div>
    </section>

    <!-- BLOG -->
    <section id="blog" class="section blog-band">
      <div class="wrap">
        <div class="section-head reveal blog-head">
          <p class="blog-kicker"><span aria-hidden="true"></span>Blog do Wilson</p>
          <div class="blog-head-row">
            <h2 class="title">Notícias, propostas e caminhada.</h2>
            <a class="btn btn-outline blog-head-cta" href="/blog">Ver todas as postagens</a>
          </div>
        </div>

        {
          posts.length === 0 ? (
            <p class="lead">Em breve, novos conteúdos por aqui.</p>
          ) : (
            <div class="blog-list reveal">
              {posts.map((post) => <BlogCard post={post} headingLevel="h3" />)}
            </div>
          )
        }
      </div>
    </section>

    <!-- APOIE -->
    <section id="apoie" class="section section-dark">
      <div class="wrap">
        <p class="eyebrow on-dark support-marker reveal">Apoie</p>

        <div class="support-grid">
          <aside class="support-aside reveal">
            <figure class="support-card">
              <img
                src="/assets/wilson-campos-card-campanha.webp"
                alt="Peça de campanha de Wilson Campos, Democrata 35"
                width="1254"
                height="1254"
                loading="lazy"
                decoding="async"
              />
            </figure>
            <div class="support-contacts">
              <a href="tel:+5531999637470">{PHONE_DISPLAY}</a>
              <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
            </div>
            <div class="support-social">
              <p>Acompanhe a campanha</p>
              <SocialLinks class="social-links-on-dark" whatsapp label="Redes sociais e WhatsApp da campanha" />
            </div>
          </aside>

          <form class="support-form reveal" method="post" data-support-form>
            <div class="support-form-head">
              <span>Quero participar</span>
              <h2>Conte com o meu apoio</h2>
              <p>Preencha seus dados e a campanha entra em contato.</p>
            </div>

            <div class="support-form-grid">
              <label class="field field-wide">
                <span>Nome completo <b aria-hidden="true">*</b></span>
                <input type="text" name="nome" autocomplete="name" placeholder="Como você gostaria de ser chamado?" required />
              </label>

              <label class="field">
                <span>Profissão</span>
                <input type="text" name="profissao" autocomplete="organization-title" placeholder="Sua área de atuação" />
              </label>

              <label class="field">
                <span>Cidade</span>
                <input type="text" name="cidade" autocomplete="address-level2" placeholder="Onde você mora?" />
              </label>

              <label class="field">
                <span>E-mail <b aria-hidden="true">*</b></span>
                <input type="email" name="email" autocomplete="email" placeholder="voce@exemplo.com" required />
              </label>

              <label class="field">
                <span>Telefone ou WhatsApp</span>
                <input type="tel" name="telefone" autocomplete="tel" inputmode="tel" placeholder="(31) 9 0000-0000" />
              </label>

              <label class="field field-wide">
                <span>Como você quer participar?</span>
                <textarea
                  name="contribuicao"
                  rows="3"
                  placeholder="Nas redes, em encontros ou mobilizando pessoas."
                ></textarea>
              </label>
            </div>

            {/* campo isca: fica escondido para gente e visível para robô */}
            <div class="honeypot" aria-hidden="true">
              <label>
                Apelido
                <input type="text" name="apelido" tabindex="-1" autocomplete="off" />
              </label>
            </div>

            <label class="consent-field">
              <input type="checkbox" name="consentimento_lgpd" value="aceito" required />
              <span>
                Concordo com o uso dos meus dados para contato e comunicações da campanha, conforme a LGPD e a
                <a href={PRIVACY_PATH}>Política de Privacidade</a>.
              </span>
            </label>

            {TURNSTILE_SITE_KEY && (
              <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-language="pt-br" />
            )}

            <div class="support-form-footer">
              <p><b>*</b> Campos obrigatórios</p>
              <button class="btn btn-milho" type="submit" data-support-submit>Enviar meu apoio</button>
            </div>

            <p class="support-form-status" data-support-status role="status" aria-live="polite" hidden></p>
          </form>

          {/* Tela de obrigado: entra no lugar do formulário depois do envio */}
          <div class="support-done" data-support-done hidden>
            <span class="support-done-check" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <path d="m4 12.5 5.5 5.5L20 7" />
              </svg>
            </span>
            <h2 tabindex="-1" data-support-done-title>Obrigado, seu apoio foi registrado!</h2>
            <p>
              A campanha recebeu seus dados e entra em contato em breve. Enquanto isso, você já pode ajudar de outras
              formas:
            </p>
            <div class="support-done-actions">
              <a class="btn btn-whatsapp" href={WHATSAPP_HREF} target="_blank" rel="noreferrer">Falar no WhatsApp</a>
              <a class="btn btn-outline" href={INSTAGRAM_HREF} target="_blank" rel="noreferrer">Seguir no Instagram</a>
            </div>
            <button class="support-done-again" type="button" data-support-again>
              Cadastrar outra pessoa
            </button>
          </div>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
  <WhatsAppFloat />

  {TURNSTILE_SITE_KEY && (
    <script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js" />
  )}

  <script define:vars={{ endpoint: FORM_ENDPOINT }}>
    /* O formulário é estático: sem isto o navegador recarrega a página e o
       apoio se perde. */
    const form = document.querySelector('[data-support-form]');
    if (form) {
      const botao = form.querySelector('[data-support-submit]');
      const status = form.querySelector('[data-support-status]');
      const obrigado = document.querySelector('[data-support-done]');
      const tituloObrigado = obrigado?.querySelector('[data-support-done-title]');
      const rotuloOriginal = botao.textContent;

      /* Máscara de telefone: formata enquanto digita, aceita celular (9
         dígitos) e fixo (8), e sobrevive a colar texto com pontuação. */
      const telefone = form.querySelector('[name="telefone"]');
      if (telefone) {
        const formatar = (valor) => {
          const d = valor.replace(/\D/g, '').slice(0, 11);
          if (d.length <= 2) return d.length ? '(' + d : '';
          const ddd = '(' + d.slice(0, 2) + ') ';
          if (d.length <= 6) return ddd + d.slice(2);
          if (d.length <= 10) return ddd + d.slice(2, 6) + '-' + d.slice(6);
          return ddd + d.slice(2, 7) + '-' + d.slice(7);
        };

        telefone.addEventListener('input', () => {
          /* apagar no meio do número não pode reescrever o cursor para o fim */
          const fimDoTexto = telefone.selectionStart === telefone.value.length;
          telefone.value = formatar(telefone.value);
          if (fimDoTexto) telefone.setSelectionRange(telefone.value.length, telefone.value.length);
        });
      }

      const mostrar = (texto, tipo) => {
        status.textContent = texto;
        status.dataset.tipo = tipo;
        status.hidden = false;
      };

      form.addEventListener('submit', async (evento) => {
        evento.preventDefault();
        if (botao.disabled) return;

        const dados = Object.fromEntries(new FormData(form).entries());
        const token = form.querySelector('[name="cf-turnstile-response"]');
        if (token) dados.turnstile = token.value;

        botao.disabled = true;
        botao.textContent = 'Enviando…';
        mostrar('Enviando seu apoio…', 'enviando');

        try {
          const resposta = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(dados),
          });
          const corpo = await resposta.json().catch(() => ({}));

          if (resposta.ok && corpo.ok) {
            const primeiroNome = String(dados.nome || '').trim().split(/\s+/)[0];
            form.reset();
            botao.disabled = false;
            botao.textContent = rotuloOriginal;
            status.hidden = true;

            if (obrigado) {
              if (primeiroNome && tituloObrigado) {
                tituloObrigado.textContent = 'Obrigado, ' + primeiroNome + '!';
              }
              form.hidden = true;
              obrigado.hidden = false;
              /* leva o foco para a tela nova: quem usa leitor de tela ou
                 teclado continuaria preso no formulário escondido */
              tituloObrigado?.focus();
              obrigado.scrollIntoView({ block: 'center', behavior: 'smooth' });
            } else {
              mostrar('Apoio recebido. A campanha entra em contato em breve. Obrigado!', 'sucesso');
            }
            return;
          }
          mostrar(corpo.erro || 'Não conseguimos registrar agora. Tente novamente em instantes.', 'erro');
        } catch {
          /* sem internet ou WordPress fora do ar: o WhatsApp continua valendo */
          mostrar('Falha de conexão. Tente novamente ou fale com a campanha pelo WhatsApp.', 'erro');
        }

        botao.disabled = false;
        botao.textContent = rotuloOriginal;
        if (window.turnstile) window.turnstile.reset();
      });

      /* "cadastrar outra pessoa": em evento de rua, uma pessoa cadastra várias */
      document.querySelector('[data-support-again]')?.addEventListener('click', () => {
        obrigado.hidden = true;
        form.hidden = false;
        form.querySelector('[name="nome"]')?.focus();
      });
    }
  </script>

  <script>
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('animate-in');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 },
    );
    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
  </script>
</Layout>
