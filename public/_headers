# Cabeçalhos do Cloudflare Pages. Este arquivo é copiado para dist/ no build.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), camera=(), microphone=()

# HTML sempre revalidado: sem isso o visitante fica preso numa versão antiga
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# arquivos com hash no nome podem ser cacheados para sempre
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=2592000
